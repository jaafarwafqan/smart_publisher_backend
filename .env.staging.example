# Copy outside the repository or inject through the host's secret manager.
# Never commit the filled file. Values below are deliberately non-functional.
APP_NAME="Smart Publisher"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
# Laravel's default log channel writes to storage/logs/laravel.log inside
# the container's own ephemeral filesystem — invisible on platforms (Render
# included) whose log viewer only captures stdout/stderr. Without this, a
# caught-and-logged failure (e.g. RegisterController's mail-send warning)
# looks identical to success everywhere except inside the dead container.
LOG_CHANNEL=stderr
APP_URL=https://staging-api.example.com
FRONTEND_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
TRUSTED_PROXIES=*
SECURITY_REQUIRE_HTTPS=true
SESSION_SECURE_COOKIE=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=true
SECURITY_HSTS_PRELOAD=false

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smart_publisher_staging
DB_USERNAME=
DB_PASSWORD=
DB_ENGINE=InnoDB
# Paste the Aiven CA PEM through the deployment secret store; Render startup
# writes it to a temporary file for PDO MySQL TLS.
MYSQL_ATTR_SSL_CA_CONTENT=

CACHE_STORE=database
DB_CACHE_CONNECTION=mysql
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=mysql
DB_CACHE_LOCK_TABLE=cache_locks
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
# Must stay greater than the worker's --timeout=60 value.
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_TABLE=sessions

# Publishing jobs run separately from the default queue, but both are drained
# by the same worker command: --queue=publishing,default.
PUBLISH_QUEUE_NAME=publishing

# Render runs Web and Worker in separate containers. This flag makes staging
# fail closed unless media is on an S3-compatible shared disk.
SP_SEPARATE_QUEUE_WORKER=true
MEDIA_UPLOAD_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Leave false for normal deploys. Set true only for a deliberately fresh
# database bootstrap, then return it to false. Existing admins are never
# updated by the bootstrap seeder.
SP_INITIALIZE_DATABASE=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Use an actual provider; log, array, and failover are refused in staging.
# MAIL_SCHEME accepts only 'smtp' (opportunistic STARTTLS — matches most
# providers, including Mailtrap's sandbox) or 'smtps' (implicit TLS); 'tls'
# throws "scheme is not supported" and silently drops every mail (confirmed
# live against Render — see docker/render/start.sh's LOG_CHANNEL=stderr
# note for why that failure is invisible without it). If deploying to a
# platform that blocks common SMTP ports (Render does), try 2525 before
# assuming credentials are wrong — a real connectivity block looks
# identical to a hang, not an auth error.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Smart Publisher"

# Closed beta providers: Facebook Pages and Telegram channels only. Facebook
# needs these application credentials. Telegram connects a per-account bot
# token through the application; no deployment-level Telegram OAuth secret is
# required. Do not provision Instagram, X, LinkedIn, YouTube, or WhatsApp
# secrets for this closed beta.
SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=

# Required by docker/docker-compose.yml for a publicly trusted TLS certificate.
APP_HOSTNAME=staging-api.example.com
ACME_EMAIL=ops@example.com
