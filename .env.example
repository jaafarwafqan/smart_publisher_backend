APP_NAME="الناشر الذكي"
APP_ENV=local
APP_KEY=
# LOCAL DEVELOPMENT ONLY. The application refuses APP_DEBUG=true in staging
# or production; use .env.staging.example as the deployment template.
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:65194
# Comma-separated list of allowed CORS origins for production. Leave unset
# locally to keep the wildcard localhost dev defaults in config/cors.php.
# CORS_ALLOWED_ORIGINS=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smart_publisher
# Local development values only. Production must inject distinct non-root
# credentials through its secret store; never leave DB_PASSWORD empty.
DB_USERNAME=smart_publisher
DB_PASSWORD=change-me-local
DB_ENGINE=InnoDB

SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=mysql
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
# Must remain greater than the worker --timeout so a slow but live worker is
# never released for duplicate processing.
DB_QUEUE_RETRY_AFTER=120
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
DB_CACHE_CONNECTION=mysql
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=mysql
DB_CACHE_LOCK_TABLE=cache_locks

# CACHE_PREFIX=

# Publishing jobs intentionally use their own queue; all other queued work
# uses the database connection's default queue above.
PUBLISH_QUEUE_NAME=publishing

ADMIN_NAME="Smart Publisher Admin"
ADMIN_EMAIL=admin@smartpublisher.local
# Must be changed before running AdminUserSeeder anywhere but local dev —
# AdminUserSeeder refuses this and other known-weak defaults in production.
ADMIN_PASSWORD=CHANGE_ME_BEFORE_DEPLOY

SOCIAL_OAUTH_STATE_TTL_MINUTES=15
SOCIAL_DEFAULT_TOKEN_TTL_MINUTES=60

# Comma-separated exact-match allowlist for beginOAuthAuthorization()'s
# redirect_uri — the Flutter app only ever sends smartpublisher://oauth/callback.
SOCIAL_ALLOWED_REDIRECT_URIS=smartpublisher://oauth/callback

SOCIAL_FACEBOOK_CLIENT_ID=
SOCIAL_FACEBOOK_CLIENT_SECRET=
SOCIAL_FACEBOOK_AUTHORIZE_URL=https://www.facebook.com/v20.0/dialog/oauth
SOCIAL_FACEBOOK_TOKEN_URL=https://graph.facebook.com/v20.0/oauth/access_token

# Phase 3 (webhook receiver, 2026-08-16): the exact "Verify Token" value
# pasted into the Meta App Dashboard's Webhooks product for this app — see
# docs/api/webhooks.md. Leaving this unset makes the GET handshake fail
# closed (403) rather than accepting any caller.
FACEBOOK_WEBHOOK_VERIFY_TOKEN=

SOCIAL_INSTAGRAM_CLIENT_ID=
SOCIAL_INSTAGRAM_CLIENT_SECRET=
SOCIAL_INSTAGRAM_AUTHORIZE_URL=https://api.instagram.com/oauth/authorize
SOCIAL_INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token

SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_X_AUTHORIZE_URL=https://twitter.com/i/oauth2/authorize
SOCIAL_X_TOKEN_URL=https://api.twitter.com/2/oauth2/token

SOCIAL_TELEGRAM_CLIENT_ID=
SOCIAL_TELEGRAM_CLIENT_SECRET=
SOCIAL_TELEGRAM_AUTHORIZE_URL=
SOCIAL_TELEGRAM_TOKEN_URL=

SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_AUTHORIZE_URL=https://www.linkedin.com/oauth/v2/authorization
SOCIAL_LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken

SOCIAL_YOUTUBE_CLIENT_ID=
SOCIAL_YOUTUBE_CLIENT_SECRET=
SOCIAL_YOUTUBE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
SOCIAL_YOUTUBE_TOKEN_URL=https://oauth2.googleapis.com/token

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 4 (observability, 2026-08-16): app:ops-snapshot's alert thresholds
# (defaults shown — see config/ops.php). Real either way; the Telegram pair
# below is the only opt-in part.
OPS_ALERT_QUEUE_LENGTH=200
OPS_ALERT_PUBLISH_FAILURE_RATE=0.05
OPS_ALERT_RETRY_STORM_COUNT=50
OPS_ALERT_DEAD_LETTER_OPEN_COUNT=20
OPS_FAILURE_RATE_WINDOW_MINUTES=60

# Optional: a Telegram bot token + admin chat id to also deliver a real
# message on a threshold breach, on top of the structured log entry that
# always fires either way. Leave both unset to stay log-only.
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=

# 2026-08-21: prepaid billing + Iraqi payment gateways. BILLING_GATEWAY
# selects which PaymentGatewayContract implementation the container binds —
# 'stripe' (recurring, international/UAE-entity option), 'fib', or
# 'zaincash'. No real prices, keys, or secrets are ever committed here —
# every value below is empty and must be filled in per-environment.
BILLING_GATEWAY=stripe
BILLING_RETURN_URL=

# Stripe — kept as a documented future option, not deleted. See
# config/billing.php.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# FIB (First Iraqi Bank) — via first-iraqi-bank/fib-laravel-payment-sdk.
# config/fib.php (published from that package) reads FIB_API_KEY/
# FIB_API_SECRET rather than the SDK's own default FIB_CLIENT_ID/
# FIB_CLIENT_SECRET — see that file's own comment.
FIB_API_KEY=
FIB_API_SECRET=
FIB_BASE_URL=https://api.fibpayment.com
FIB_GRANT_TYPE=client_credentials
FIB_REFUNDABLE_FOR=P7D
FIB_CURRENCY=IQD
FIB_CALLBACK_URL=
FIB_DEFAULT_ACCOUNT=default

# ZainCash — hand-integrated (no official Laravel SDK). Test environment
# base URL is https://pg-api-uat.zaincash.iq; MSISDN is this merchant's own
# phone number, not a customer's. IQD only.
ZAINCASH_BASE_URL=https://pg-api-uat.zaincash.iq
ZAINCASH_CLIENT_ID=
ZAINCASH_CLIENT_SECRET=
ZAINCASH_MSISDN=
ZAINCASH_SUCCESS_URL=
ZAINCASH_FAILURE_URL=
